<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/perfume_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/perfume_card_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgPerfume"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@color/perfume_gold_light"
            android:padding="12dp"
            android:src="@drawable/ic_perfume_bottle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/app_name" />

        <ImageView
            android:id="@+id/btnFav"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_heart_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/tab_favorites" />

        <TextView
            android:id="@+id/txtCategoryTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/perfume_gold_light"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/perfume_wine"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imgPerfume"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtPerfumeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/perfume_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnFav"
            app:layout_constraintStart_toEndOf="@id/imgPerfume"
            app:layout_constraintTop_toBottomOf="@id/txtCategoryTag" />

        <TextView
            android:id="@+id/txtBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/perfume_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/btnFav"
            app:layout_constraintStart_toEndOf="@id/imgPerfume"
            app:layout_constraintTop_toBottomOf="@id/txtPerfumeName" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/perfume_wine"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgPerfume" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/perfume_wine"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/add_to_cart"
            android:textColor="@color/perfume_surface"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtBrand" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
